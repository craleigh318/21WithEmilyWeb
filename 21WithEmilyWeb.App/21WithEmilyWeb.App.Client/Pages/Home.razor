@page "/"
@rendermode InteractiveAuto
@using _21WithEmilyWeb.Contracts.Dtos
@inject _21WithEmilyWeb.App.Client.Services.GameApiClient GameApiClient
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger

<PageTitle>21 with Emily</PageTitle>

@if (gameState is not null)
{
	<Play GameState="@gameState" EmilyThinking="@emilyThinking" IsStartingGame="@isStartingGame" OnCountSelected="HandleCountSelected" OnNewGame="StartGame" />
}
else
{
	<Hi OnOk="StartGame" OkButtonEnabled="@(!isStartingGame)" />
}

@code {
	private GameResponse? gameState = null;
	private bool isStartingGame = false;
	private bool emilyThinking = false;

	private async Task StartGame()
	{
		isStartingGame = true;
		await InvokeAsync(StateHasChanged);
		try
		{
			gameState = await GameApiClient.NewGameAsync();
		}
		catch (Exception exception)
		{
			Logger.LogError(exception, "Failed to start a new game.");
		}
		finally
		{
			isStartingGame = false;
		}
	}

	private async Task HandleCountSelected(int count)
	{
		if (gameState is not GameResponse activeGameState)
		{
			return;
		}

		emilyThinking = true;
		try
		{
			var request = new CountRequest
			{
				GameId = activeGameState.GameId,
				Count = count
			};

			var countTask = GameApiClient.CountAsync(request);
			var minimumWaitTask = Task.Delay(TimeSpan.FromSeconds(1));

			await Task.WhenAll(countTask, minimumWaitTask);
			gameState = await countTask;
		}
		catch (Exception exception)
		{
			Logger.LogError(exception, "Failed to submit a count of {Count} for game {GameId}.", count, activeGameState.GameId);
		}
		finally
		{
			emilyThinking = false;
		}
	}
}