@page "/"
@rendermode InteractiveAuto
@using _21WithEmilyWeb.Contracts.Dtos
@inject _21WithEmilyWeb.App.Client.Services.GameApiClient GameApiClient
@inject Microsoft.Extensions.Logging.ILogger<Home> Logger

<PageTitle>21 with Emily</PageTitle>

@if (gameId is not null)
{
	<Play EmilyThinking="@emilyThinking" CountOptions="@countOptions" OnCountSelected="HandleCountSelected" />
}
else
{
	<Hi OnOk="StartGame" OkButtonEnabled="@(!isStartingGame)" />
}

@code {
	private int? gameId = null;
	private bool isStartingGame = false;
	private bool emilyThinking = false;
	private int[] countOptions = [];

	private async Task StartGame()
	{
		isStartingGame = true;
		await InvokeAsync(StateHasChanged);
		try
		{
			var response = await GameApiClient.NewGameAsync();
			gameId = response.GameId;
			countOptions = response.AllowedCounts ?? [];
		}
		catch (Exception exception)
		{
			Logger.LogError(exception, "Failed to start a new game.");
		}
		finally
		{
			isStartingGame = false;
		}
	}

	private async Task HandleCountSelected(int count)
	{
		if (gameId is not int activeGameId)
		{
			return;
		}

		emilyThinking = true;
		try
		{
			var request = new CountRequest
			{
				GameId = activeGameId,
				Count = count
			};

			var response = await GameApiClient.CountAsync(request);
			countOptions = response.AllowedCounts ?? [];
		}
		catch (Exception exception)
		{
			Logger.LogError(exception, "Failed to submit a count of {Count} for game {GameId}.", count, activeGameId);
		}
		finally
		{
			emilyThinking = false;
		}
	}
}