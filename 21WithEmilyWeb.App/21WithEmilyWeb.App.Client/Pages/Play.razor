@using _21WithEmilyWeb.Contracts.Dtos

<section class="play-layout" aria-label="Game">
    <p class="play-score">Score: @GameState.Score</p>

    <img class="play-emily" src="images/Emily@(EmilyImageName).gif" alt="Emily" />
    <div class="play-buttons" role="group" aria-label="Choose a count">
        <button disabled="@(EmilyThinking || GameState.Winner is not null || CountOptions.Length < 1)" @onclick="() => OnCountSelected.InvokeAsync(CountOptions[0])">@(CountOptions.Length > 0 ? CountOptions[0].ToString() : string.Empty)</button>
        <button disabled="@(EmilyThinking || GameState.Winner is not null || CountOptions.Length < 2)" @onclick="() => OnCountSelected.InvokeAsync(CountOptions[1])">@(CountOptions.Length > 1 ? CountOptions[1].ToString() : string.Empty)</button>
        <button disabled="@(EmilyThinking || GameState.Winner is not null || CountOptions.Length < 3)" @onclick="() => OnCountSelected.InvokeAsync(CountOptions[2])">@(CountOptions.Length > 2 ? CountOptions[2].ToString() : string.Empty)</button>
    </div>
</section>

@code {
	[Parameter] public GameResponse GameState { get; set; } = default!;
	[Parameter] public bool EmilyThinking { get; set; } = false;
	[Parameter] public EventCallback<int> OnCountSelected { get; set; }

	private int[] CountOptions => GameState.AllowedCounts ?? [];

    private string EmilyImageName
    {
        get
        {
            if (EmilyThinking)
            {
                return "Thinking";
            }
            else if (GameState.Winner is "Emily")
            {
                return "Winner";
            }
            else if (GameState.Winner is "Player")
            {
                return "Loser";
            }
            else
            {
                return "Normal";
            }
        }
    }
}
