@using _21WithEmilyWeb.Contracts.Dtos

<section class="game-layout" aria-label="Game">
    <p class="game-id">Game ID: @GameState.GameId</p>
    <img class="play-emily" src="images/Emily@(EmilyImageName).gif" alt="Emily" />

    <p class="play-score">@GameState.Score</p>

    <div class="game-buttons" role="group" aria-label="Choose a count">
        <button class="game-button" disabled="@IsCountDisabled(0)" @onclick="() => OnCountSelected.InvokeAsync(CountOptions[0])">@GetCountText(0)</button>
        <button class="game-button" disabled="@IsCountDisabled(1)" @onclick="() => OnCountSelected.InvokeAsync(CountOptions[1])">@GetCountText(1)</button>
        <button class="game-button" disabled="@IsCountDisabled(2)" @onclick="() => OnCountSelected.InvokeAsync(CountOptions[2])">@GetCountText(2)</button>
    </div>
    <div class="game-outcome" role="status" aria-live="polite">@OutcomeMessage</div>
    <button class="game-button" disabled="@(IsStartingGame || EmilyThinking || GameState.Score <= 0)" @onclick="OnNewGame">New Game</button>
    <dl class="win-scoreboard" aria-label="Win record">
        <div>
            <dt>Your wins</dt>
            <dd>@PlayerWins</dd>
        </div>
        <div>
            <dt>Emily's wins</dt>
            <dd>@EmilyWins</dd>
        </div>
        <div>
            <dt>Total wins</dt>
            <dd>@(PlayerWins + EmilyWins)</dd>
        </div>
    </dl>
</section>

@code {
	[Parameter] public GameResponse GameState { get; set; } = default!;
    [Parameter] public bool EmilyThinking { get; set; } = false;
    [Parameter] public bool IsStartingGame { get; set; } = false;
    [Parameter] public int PlayerWins { get; set; } = 0;
    [Parameter] public int EmilyWins { get; set; } = 0;
    [Parameter] public EventCallback<int> OnCountSelected { get; set; }
    [Parameter] public EventCallback OnNewGame { get; set; }

	private int[] CountOptions => GameState.AllowedCounts ?? [];
    private bool IsCountDisabled(int index) => IsStartingGame || EmilyThinking || GameState.Winner is not null || CountOptions.Length <= index;
    private string GetCountText(int index) => CountOptions.Length > index ? CountOptions[index].ToString() : string.Empty;
    private string OutcomeMessage => GameState.Winner switch
    {
        "Player" => "You win!",
        "Emily" => "You lose!",
        _ => string.Empty
    };

    private string EmilyImageName
    {
        get
        {
            if (EmilyThinking)
            {
                return "Thinking";
            }
            else if (GameState.Winner is "Emily")
            {
                return "Winner";
            }
            else if (GameState.Winner is "Player")
            {
                return "Loser";
            }
            else
            {
                return "Normal";
            }
        }
    }
}
